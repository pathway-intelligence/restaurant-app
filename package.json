{
  "name": "restaurant-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run db:migrate && next dev",
    "build": "next build",
    "start": "npm run db:migrate && next start",
    "db:migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning db/migrate.ts",
    "db:reset": "node --experimental-strip-types --disable-warning=ExperimentalWarning db/migrate.ts --reset"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
